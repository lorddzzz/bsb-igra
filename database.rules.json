{
  "rules": {
    "history": {
      ".read": "auth != null",
      "$game": {
        ".write": "auth != null && !data.exists() && newData.hasChildren(['game', 'players', 'at'])"
      }
    },
    "rooms": {
      "$code": {
        "pub": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "online": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "tickets": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null"
          }
        },
        "secret": {
          ".read": "auth != null && root.child('rooms').child($code).child('pub/phase').val().matches(/^(reveal|guess|missions|score|over)$/)",
          ".write": "auth != null"
        }
      }
    }
  }
}
